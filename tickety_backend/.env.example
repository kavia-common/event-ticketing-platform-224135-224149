# Tickety Backend (.env)
# NOTE: Do not commit real secrets. This file documents required variables.

# --- Database (from tickety_database container env vars) ---
POSTGRES_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# --- App / Security ---
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Used to build links in emails and Stripe return_url
SITE_URL=http://localhost:3000

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (optional; if not set, backend will log emails instead of sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tickety <no-reply@tickety.local>"
SMTP_USE_TLS=true
